{
  "expo": {
    "name": "Signet",
    "slug": "signet-mobile",
    "scheme": "signet",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1128"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.signet.wallet",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Signet uses Face ID to unlock your wallet quickly and securely.",
        "NSCameraUsageDescription": "Signet uses your camera to scan QR codes for receiving payments."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1128",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.signet.wallet",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Signet needs camera access to scan QR codes."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Signet uses Face ID to unlock your wallet."
        }
      ]
    ]
  }
}
